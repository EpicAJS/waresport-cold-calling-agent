# --- Required ---
# Postgres connection string (Neon / Vercel Postgres / Supabase / your own server)
DATABASE_URL=postgres://user:password@host:5432/waresport
# Long random string used for sessions, encrypting stored keys, and signing unsubscribe links.
# Generate with: openssl rand -base64 32   (changing it logs everyone out and invalidates saved keys)
AUTH_SECRET=
# Public URL of the app (used in emails, invite links, and webhook URLs). On Vercel this falls back
# to the production domain automatically, but setting it explicitly is recommended.
APP_URL=https://your-app.vercel.app
# Protects /api/cron/dispatch. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Calling ---
BLAND_AI_API_KEY=
# Optional but recommended: Bland webhooks must include ?token=<this> to be accepted.
WEBHOOK_SECRET=

# --- Finding contacts ---
SERP_API_KEY=

# --- AI script & email writer ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Email (optional here; admins can also set these in Settings → Company) ---
# RESEND_API_KEY=
# EMAIL_FROM=team@yourdomain.com
