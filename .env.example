# --- Required ---
# Postgres connection string (Neon / Vercel Postgres / Supabase / your own server)
DATABASE_URL=postgres://user:password@host:5432/waresport
# Long random string for sessions, encrypting stored tokens/keys, and signing links.
# Generate with: openssl rand -base64 32   (changing it signs everyone out and requires reconnecting inboxes)
AUTH_SECRET=
# Public URL of the app (emails, tracking pixels, OAuth redirects, webhooks).
APP_URL=https://your-app.vercel.app
# Protects /api/cron/dispatch (Vercel Cron / GitHub Action / your server's cron send it as a Bearer token).
CRON_SECRET=

# --- Gmail / Google sign-in (see README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook / Microsoft sign-in (see README) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your Azure tenant ID, or "common" to allow any Microsoft work/personal account
MICROSOFT_TENANT_ID=common

# --- AI: reply classification, suggested replies, personalized openers, script/email writer ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- AI calling ---
BLAND_AI_API_KEY=
# Bland webhooks must include ?token=<this> to be accepted.
WEBHOOK_SECRET=

# --- Club search ---
SERP_API_KEY=

# --- System email (invites, password resets) — or set in Settings → Company ---
# RESEND_API_KEY=
# EMAIL_FROM=team@yourdomain.com
